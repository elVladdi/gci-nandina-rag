{
  "version": "top3_explainer_schema_v0.2",
  "source_prompt": "src/llm/explain_top3_nandina_prompt_v0.2.md",
  "required_root_fields": ["id_unico", "case_id", "descripcion_mercancia", "resumen_observable", "candidatos_explicados", "comparacion_top3", "advertencias_globales", "conclusion_auditable", "advertencia_final"],
  "candidate_count": 3,
